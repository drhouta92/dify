# /etc/swing-bot.env  (systemd EnvironmentFile syntax: KEY=value, no 'export', no quotes)
# Root-owned, chmod 600. PAPER keys only; the bot refuses any non-paper endpoint.
ALPACA_API_KEY=PASTE_PAPER_KEY_HERE
ALPACA_SECRET_KEY=PASTE_PAPER_SECRET_HERE
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Data feeds: intraday must be real-time ('iex' on the free plan). Daily bars use SIP,
# which Alpaca serves free once >15 min old; the bot falls back to IEX automatically.
SWING_INTRADAY_FEED=iex
SWING_DAILY_FEED=sip

# Risk (fractions). Sizing equity is a MODEL account; 0 = use broker equity.
SWING_SIZING_EQUITY=1000
SWING_RISK_PER_TRADE=0.01
SWING_MAX_POSITION_PCT=0.25
SWING_MAX_OPEN_POSITIONS=4
SWING_MAX_TRADES_PER_DAY=1
SWING_DAILY_LOSS_LIMIT_PCT=0.03
SWING_MAX_DRAWDOWN_PCT=0.15

# Every StrategyParams / RiskParams / UniverseParams / RuntimeParams field can be set as
# SWING_<FIELD_NAME_UPPERCASE>; invalid values abort start-up (see swingbot/config.py).
